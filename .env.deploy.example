# Strongly recommended in cloud:
SEOUL_BUS_API_KEY=YOUR_SERVICE_KEY

# Optional. If a persistent disk/volume contains historical_latest.csv:
SITBUS_DATA_DIR=/data
HISTORICAL_CSV_PATH=/data/historical_latest.csv
DB_PATH=/data/seat_service.sqlite3

# Defaults:
DEFAULT_HEADWAY_MIN=6
SERVICE_DAYS=31
EFFECTIVE_CAPACITY=45
